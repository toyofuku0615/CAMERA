{
  "name": "backstage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node scripts/prepare-test-fixtures.mjs && playwright test",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "predev": "npm run prepare:vision",
    "prebuild": "npm run prepare:vision",
    "test:photos": "node scripts/evaluate-photos.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
